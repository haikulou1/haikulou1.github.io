<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>haikulou-auth</display-name>
    <description>用户登录认证服务</description>

    <!-- CORS 跨域过滤器，应用于所有路径 -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>cn.haikulou.auth.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 登录入口 -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>cn.haikulou.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/api/login</url-pattern>
    </servlet-mapping>

    <!-- 登出入口 -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>cn.haikulou.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/api/logout</url-pattern>
    </servlet-mapping>

    <!-- 获取当前用户信息 -->
    <servlet>
        <servlet-name>CurrentUserServlet</servlet-name>
        <servlet-class>cn.haikulou.auth.CurrentUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CurrentUserServlet</servlet-name>
        <url-pattern>/api/user/current</url-pattern>
    </servlet-mapping>

</web-app>
